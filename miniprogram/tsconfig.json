{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "alwaysStrict": true,
    "module": "CommonJS",
    "target": "ES2020",
    "lib": ["ES2020"],
    "typeRoots": ["./typings"]
  },
  "include": [
    "./miniprogram/**/*.ts",
    "./typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "cloudfunctions"
  ]
}
